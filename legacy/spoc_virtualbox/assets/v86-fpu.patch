+pub unsafe fn fpu_fbld(addr: i32) {
+    return_on_pagefault!(readable_or_pagefault(addr, 10));
+    let mut x: i64 = 0;
+    let mut mul: i64 = 1;
+    for i in 0..9 {
+        let b = safe_read8(addr + i).unwrap() as i64;
+        x += (b & 0xF) * mul;
+        mul *= 10;
+        x += (b >> 4 & 0xF) * mul;
+        mul *= 10;
+    }
+    let negative = safe_read8(addr + 9).unwrap() & 0x80 != 0;
+    fpu_push(F80::of_i64(if negative { -x } else { x }));
+}
